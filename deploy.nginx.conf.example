server {
    listen 80;
    server_name your-domain.example;

    root /var/www/wb-profit-calc;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }
}
